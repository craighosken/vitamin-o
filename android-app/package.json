{
  "name": "pen-tracker-app",
  "version": "1.0.0",
  "private": true,
  "description": "Pen Tracker Android app (Capacitor wrapper around ../pen-tracker.html)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "assets": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
